{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anode Cnode event draft 0.1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": "0.1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "lease_epoch": {
      "type": "integer",
      "minimum": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "happened_at": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "enum": [
        "run.started",
        "run.progress",
        "run.waiting_input",
        "run.failed",
        "run.cancelled",
        "run.result_submitted"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "protocol_version",
    "event_id",
    "run_id",
    "lease_epoch",
    "sequence",
    "happened_at",
    "type",
    "payload"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.started"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "adapter_id": {
                "type": "string",
                "minLength": 1
              },
              "adapter_version": {
                "type": "string",
                "minLength": 1
              },
              "session_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "adapter_id",
              "adapter_version",
              "session_ref"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.progress"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "summary"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.waiting_input"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "question_ref": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "question_ref",
              "summary"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.failed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^artifact://[^\\s]+$"
                }
              }
            },
            "required": [
              "code",
              "summary",
              "evidence_refs"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.cancelled"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "stop_confirmed": {
                "const": true
              }
            },
            "required": [
              "reason",
              "stop_confirmed"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "run.result_submitted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "properties": {
              "outcome_status": {
                "type": "string",
                "enum": [
                  "completed",
                  "partial"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "takeaways": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^artifact://[^\\s]+$"
                }
              },
              "question_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "usage_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "submission": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "repository_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "base_commit_sha": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                      },
                      "result_commit_sha": {
                        "type": "string",
                        "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
                      },
                      "artifact_ref": {
                        "type": "string",
                        "pattern": "^artifact://[^\\s]+$"
                      },
                      "format": {
                        "type": "string",
                        "enum": [
                          "git_bundle",
                          "patch"
                        ]
                      }
                    },
                    "required": [
                      "repository_id",
                      "base_commit_sha",
                      "result_commit_sha",
                      "artifact_ref",
                      "format"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "outcome_status",
              "summary",
              "takeaways",
              "evidence_refs",
              "question_refs",
              "usage_refs",
              "submission"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
